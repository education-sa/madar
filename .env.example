APP_ENV=production
APP_URL=https://example.com
APP_KEY=replace-with-a-random-64-character-secret
SESSION_NAME=madar_session
ALLOW_RUNTIME_SCHEMA_CHANGES=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=madar
DB_USER=madar_user
DB_PASS=replace-with-a-strong-database-password

OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=replace-with-a-strong-initial-password

# Optional: only for running scripts/seed_demo.php locally.
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_PASSWORD=

# Optional OpenAI-compatible question generation service.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Session protection. Values are in seconds.
OWNER_SESSION_IDLE_SECONDS=1800
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=28800

# Platform enhancements.
PRIVACY_POLICY_VERSION=2026-07
# Store SQL backups outside the public web root. The default is ../../madar-backups.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
